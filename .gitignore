# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing


# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# video
*.mp4

certificates

public/sw.js
tasks.md
# Quran editions cached for the prerendered /quran routes (npm run prebuild)
/.quran-cache/

# Hadith collections, split per chapter, for the prerendered /hadith routes
# (npm run prebuild). Includes _titles/, the one-off downloads that
# scripts/build-hadith-chapters.mjs reads.
/.hadith-cache/

# Generated by scripts/build-quran-search-index.mjs (npm run predev / prebuild).
/public/quran-search-index.json
